# Copy to .env and edit. Never commit the real .env file.

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-value

# Database
# Default: local SQLite file, zero configuration needed.
# For MySQL in production: mysql+pymysql://user:password@host:3306/navora
DATABASE_URL=sqlite:///navora.db

# Optional external AI adapter (platform works fully without this).
# When unset, the AI Study Mentor and recommendation explanations
# fall back to the deterministic, explainable engine described in
# docs/recommendation-engine.md.
AI_PROVIDER_API_KEY=
AI_PROVIDER_NAME=

# Demo/admin bootstrap (used only by seed script)
ADMIN_EMAIL=admin@navora.app
ADMIN_PASSWORD=change-this-admin-password
